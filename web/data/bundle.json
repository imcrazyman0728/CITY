gger":"on_turn_end","action":"inc_count","value":-1}]},"poise":{"id":"poise","name":"호흡","effects":[],"desc":"적중 시 위력 x 5% 확률로 크리티컬 발동. (피해량 1.2배)"},"rupture":{"id":"rupture","name":"파열","desc":"피격 시 위력만큼 체력 피해를 입고 횟수가 1 감소.","effects":[{"trigger":"on_hit_received","action":"damage_self","value":"amount"},{"trigger":"on_hit_received","action":"inc_count","value":-1}]},"sinking":{"id":"sinking","name":"침잠","desc":"피격 시 위력만큼 정신력 피해를 입고 횟수가 1 감소.","effects":[{"trigger":"on_hit_received","action":"damage_sanity","value":"amount"},{"trigger":"on_hit_received","action":"inc_count","value":-1}]},"strength":{"id":"strength","name":"힘","desc":"위력만큼 모든 공격 및 반격 주사위 위력이 상승하고 턴 종료 시 횟수가 1 감소.","effects":[{"trigger":"on_turn_end","action":"inc_count","value":-1}]},"tremor":{"id":"tremor","name":"진동","effects":[],"desc":"진동 폭발 속성이 있는 주사위에 피격 시 횟수가 1 감소하고 위력만큼 흐트러짐 피해를 입음."}},"panics":{"collapsing_art":{"id":"collapsing_art","name":"무너져가는 예술","low_morale_effects":[{"trigger":"modify_roll","condition":{"kind":"all"},"action":"add_value","value":-1,"desc":"모든 주사위 위력 1 감소"}],"panic_effects":[{"trigger":"modify_roll","condition":{"kind":"all"},"action":"add_value","value":-3,"desc":"모든 주사위 위력 3 감소"}]},"falling_flowers":{"id":"falling_flowers","name":"흐드러지는 꽃무리","low_morale_effects":[{"trigger":"modify_max_roll","condition":{"kind":"all"},"action":"add_value","value":-1,"desc":"모든 주사위 최댓값 1 감소"}],"panic_effects":[{"trigger":"modify_max_roll","condition":{"kind":"all"},"action":"add_value","value":-3,"desc":"모든 주사위 최댓값 3 감소"}]},"fear":{"id":"fear","name":"공포","low_morale_effects":[{"trigger":"modify_damage_dealt","condition":{"kind":"all"},"action":"add_value","value":-2,"desc":"주는 피해량 2 감소"}],"panic_effects":[{"trigger":"modify_damage_dealt","condition":{"kind":"all"},"action":"add_value","value":-5,"desc":"주는 피해량 5 감소"}]},"weave":{"id":"weave","name":"흐트러진 방직","low_morale_effects":[{"trigger":"modify_roll","condition":{"kind":"all"},"action":"add_value","value":-1,"desc":"모든 주사위 위력 1 감소"}],"panic_effects":[{"trigger":"cannot_equip","condition":{"kind":"all"},"action":"prevent","desc":"한 턴 동안 카드를 장착할 수 없음"}]}},"gadgets":{"aesthetic_gloom":{"id":"aesthetic_gloom","name":"미적감각 [우울]","desc":"이 세상에 아름답다고 순수하게 말할 수 있는 것이 있기는 한걸까.","category":["능력","죄악"]},"agility_pride":{"id":"agility_pride","name":"민첩 [오만]","desc":"세상엔 도망칠 일들이 참 많다.","category":["능력","죄악"]},"ahn":{"id":"ahn","name":"안 [眼]","desc":"이 도시에서 통용되는 화폐이자, 모든 탐욕의 근원. 이 도시의 사람들의 원념, 희망, 꿈, 신념, 증오를 머금었다.","category":["화폐"]},"ancient_medal":{"id":"ancient_medal","name":"고대의 메달","desc":"수상한 여행자가 건네준 메달. 왠지 비쌀 것 같다.","category":["보물"]},"charm_lust":{"id":"charm_lust","name":"매력 [색욕]","desc":"아름답다는 것은 겉보기엔 쓸모가 없어 보인다. 미인계에 약한 사람들이 주로 하는 말이다.","category":["능력","죄악"]},"eloquence_invidia":{"id":"eloquence_invidia","name":"말솜씨 [질투]","desc":"총구가 겨눠져도 뻔뻔하게 거짓말을 늘어놓을 수 있는 사람만이 살아남는다.","category":["능력","죄악"]},"injured":{"id":"injured","name":"부상","desc":"아프다.","category":["상태이상"]},"intelligence_sloth":{"id":"intelligence_sloth","name":"지식 [나태]","desc":"아는 것이 많을수록, 이 도시에선 더욱 빠르게 절망한다.","category":["능력","죄악"]},"luck_gluttony":{"id":"luck_gluttony","name":"행운 [탐식]","desc":"초심자의 행운은 사람을 도박에 빠지게 하는 원인들 중 하나다.","category":["능력","죄악"]},"pendant_of_luck":{"id":"pendant_of_luck","name":"행운의 펜던트","desc":"길을 잃은 아이를 도와주고 받은 펜던트. 왠지 좋은 일이 생길 것만 같다.","category":["기타"]},"salt_candy":{"id":"salt_candy","name":"소금 사탕","desc":"검정색 장식이 곁들여진 투명한 포장지에 싸인 투명한 알사탕. 꽤나 호불호가 갈리는 간식이다.\n좋아하는 사람은 솔티드 카라멜 맛이 난다고 하고, 싫어하는 사람은 땀맛이 난다고 한다.","category":["디저트"]},"strength_wrath":{"id":"strength_wrath","name":"힘 [분노]","desc":"약육강식. 도시에서 통용되는 가장 흔한 법칙.","category":["능력","죄악"]}},"players":{"camelia":{"id":"camelia","status":{"name":"???","max_hp":80,"max_sanity":40,"stagger_resist":30,"panic_type":"falling_flowers","max_cost":4,"card_slot":2,"speed":{"min":3,"max":6},"endurance":{"slash":0.7,"pierce":1.0,"blunt":1.2},"stagger_endurance":{"slash":0.5,"pierce":0.7,"blunt":1.2},"passives":["camelia_mind"],"deck":{"slash_camelia":3,"cleave_camelia":2,"wild_strike_camelia":1,"will_camelia":2,"mode_change_camelia1":1},"card_pool":["determination","crossing_slash","get_off","refuse","execution"]}}},"stories":{"메인스토리 - 선홍빛 참회록":{"ch1":{"id":"ch1","start":"begin","nodes":{"begin":{"text":"어..그 죄송한데 여기가 데모 끝이에요...!","choices":[{"text":"아.","ending":"결말: 데모 클리어!"}]}}},"start":{"id":"start","start":"begin","nodes":{"begin":{"text":"어둠. 오직 나의 길에는 어둠만이 있었다.","choices":[{"text":"...","effects":{"set_basic_battle_theme":"rude_buster.mp3"},"next":"1"}]},"1":{"text":"더 이상 사람을 믿지 않기로 했었다.","choices":[{"text":"...","effects":{"load_player_char":"camelia"},"next":"2"}]},"2":{"text":"너는 지금 어디에 있어?","choices":[{"text":"...술집.","effects":{"give_items":{"intelligence_sloth":1}},"next":"3"},{"text":"잠깐, 나 이 이야기 알아. 넘어가자고.","requirements":{"flag_min":{"camelia_prologue":1}},"show":false,"effects":{"give_items":{"intelligence_sloth":1,"aesthetic_gloom":2,"strength_wrath":3},"exp":10,"change_name":"카멜리아","set_field_theme":"field_camelia1.mp3"},"next_main":"ch1"}]},"3":{"text":"어쩌다가 온건데?","choices":[{"text":"...그냥. 뒷골목에서 썩어가려니까 지루해서.","next":"4"}]},"4":{"text":"흐음... 왁자지껄 하네. 주변엔 노래부르는 사람도 있고, 구석에서 잔으로 실로폰을 치고 있는 사람도 있어. 너의 앞에는 안주도 놓여있고.","choices":[{"text":"잠깐... 그보다도 넌 누구야? 대체 누군데 내 머릿속에서 말을 거는거지?","next":"5"}]},"5":{"text":"음... 솔직히 설명하기는 어려우니까, 날 그냥 너의 진심에서 우러져 나오는 목소리라고 생각해. 굳이 이름을 대주자면...\n내 이름은 카르멘이야.","choices":[{"text":"카르멘... 예쁜 이름이네.","effects":{"give_items":{"aesthetic_gloom":2}},"next":"6"}]},"6":{"text":"술집에서 들려오는 소리들중에 뭔가 신경쓰이는 소리가 들려오는 것 같아.\n\"하... 요즘 검지 때문에 우리들도 피해를 입게 생긴거 알아?\"\n\"뭐?! 그거 잘 해결된거 아니었어??\"","choices":[{"text":"검지...?","next":"7"}]},"7":{"text":"너는 홀린 듯 그 이야기를 하던 패거리에게 다가갔어.","choices":[{"text":"잠깐, 누가 검지 때문에 피해를 입었다고?","next":"8"}]},"8":{"text":"\"뭐야? 뭐하는 계집인데 우리한테 말을 걸지?\"","choices":[{"text":"그냥 궁금하니까 물어보는거야.","next":"9"}]},"9":{"text":"\"이 X끼 겁대가리가 없구나?\"\n\"뭐하다 온 년인지는 몰라도, 배짱 하나는 끝내주네.\"\n키가 크고 마른 불량배 하나가 자리에서 일어나면서 말했어.\n\"네 알바는 아니니까 꺼져.\"","choices":[{"text":"그다지 쎄보이지도 않은게 왠 시비야.","next":"10"}]},"10":{"text":"\"뭐, 뭐라고? 너 지금 뭐라 했냐? 다시 씨부려봐.\"\n옆에 있던 뚱뚱한 불량배는 폭소를 터뜨리면서 말싸움을 지켜보고 있어.","choices":[{"text":"옷 밖으로 뼈가 다 보이는데, 너 옆에 있는거 휘두르다가 팔 부러지겠다?","effects":{"give_items":{"strength_wrath":3}},"next":"11"}]},"11":{"text":"\"어디서 구르다 온 계집인지는 몰라도, 말 본새가 그지 같네. 넌 오늘 나한테 좀 맞으면서 싸가지를 배워야겠다.\"\n화가 잔뜩 난 불량배가 너를 향해 철퇴를 들고 달려오기 시작했어!","choices":[{"text":"바라던 바다. 쥐어 패서라도 입을 열게 해주지. (무기를 든다.)","next":"12"}]},"12":{"text":"\"손님, 사람들 먹는 곳에서 쳐 싸우실거면 둘 다 여기서 꺼져주십시오.\"","choices":[{"text":"아, 넵...","next":"13"}]},"13":{"text":"너와 말라깽이는 점장이 내뿜는 포스에 짓눌려, 꼬리를 말고 밖으로 나왔어. 얼떨결에 내쫓긴 뚱땡이는 울상을 짓고 있네.\n\"야 경식아, 니 내 안주 몫까지 다해서 싸워라. 저런 계집 하나도 못 이기면 우리 애들 기가 살겠냐?\"\n\"말 안해도 아니까 넌 저기서 보고나 있어.\"","choices":[{"text":"쥐어 터지는 건 너겠지 X신아.","effects":{"battle":"camelia_ch0_rat"},"next":"14"}]},"14":{"text":"\"커헉... 크흡..!\"\n말라깽이는 곤죽이 되서 너의 앞에 널부러졌어.","choices":[{"text":"어때? 이제 좀 말해줄 맘이 드냐?","next":"15"}]},"15":{"text":"\"워워, 잠깐...잠깐만 스톱!\"\n뚱땡이가 손사레를 치며 다가왔어.\n\"그래 알겠어, 우리가 좀 험하게 말해서 미안했다, 응? 그러니까, 걔는 놔줘. 내가 다 말해줄게...\"","choices":[{"text":"...","next":"16"}]},"16":{"text":"\"야, 그치만 그걸 말하면 엄지 자식들이...!\"","choices":[{"text":"엄지...?","next":"17"}]},"17":{"text":"\"히이익..!\"\n말라깽이는 꼴사납게 떨어대며 몸을 말았어.","choices":[{"text":"저리 짜져 있어.","next":"18"}]},"18":{"text":"\"경식아, 그것까지 말해버리면...\"\n너의 검술을 본 탓일까? 뚱땡이는 체념하고는 입을 열었어.","choices":[{"text":"다음","next":"19"}]},"19":{"text":"\"그러니까, 일단 우리는 엄지의 수하 조직이다. 일개 따까리 뿐이다 이 말이지. 근데 엄지, 그것도 카포라는 놈들이 자꾸 말도 안되는 요구를 하잖냐.\"\n","choices":[{"text":"무슨 개같은 청탁을 했는데?","next":"20"}]},"20":{"text":"\"뒷골목에 숨어있는 애x끼들을 전부 잡아서...\"","choices":[{"text":"잡아서?","next":"21"}]},"21":{"text":"\"멱을 따버리라고...\"","choices":[{"text":"(뚱땡이의 멱살을 쥔다.)","next":"22"}]},"22":{"text":"\"아...아직 아무도 안 죽였어! 진짜야!\"","choices":[{"text":"무슨 수작인지는 몰라도, 애들을 죽인다고? 무슨 개짓거리지?","next":"23"}]},"23":{"text":"\"우리인들 그걸 알겠냐고! 그냥 안하면 죽여버리겠다고 칼들고 협박하는데, 그럼 그냥 죽으라고?!\"\n\"끄으윽... 그러니까... 우리한테 이러는 거 그만하고... 22구 쪽 찾아가봐...\"","choices":[{"text":"...(뚱땡이의 멱살을 놓는다.)","next":"24"}]},"24":{"text":"\"그, 그럼 우린 이만!\"\n뚱땡이는 황급히 바닥에 널부러진 말라깽이를 들쳐 업고 도망쳤어.","choices":[{"text":"하... 또다시 그 지옥 속으로 기어 들어가야 한다니.","next":"25"}]},"25":{"text":"잠시동안 과거의 끔찍했던 기억들이 너의 머릿속을 스쳐 지나갔어. 하지만 아무 죄도 없는 아이들이 전부 죽을지도 모른다는데, 가만히 있을 수 만은 없겠지.\n어째서 그렇게까지 애들을 소중히 여기는거야?","choices":[{"text":"...아직 때묻지 않았으니까.","next":"26"}]},"26":{"text":"흐음... 알겠어. 구태여 더 묻지는 않을게.\n뭐, 모든 여정이 그렇게 시작되는거지!\n아까 나의 이름을 내가 알려줬으니, 네 이름도 알려줄래?","choices":[{"text":"또다시 시련 속으로 걸음할 나의 이름은....","effects":{"change_name":"카멜리아","set_field_theme":"field_camelia1.mp3","set_flag":{"camelia_prologue":1},"hp":999},"next_main":"ch1"}]}}}},"메인스토리 - 오발탄":{}},"common":[{"id":"carnival","start":"begin","nodes":{"begin":{"text":"\"되살아나서 이 곳에 떨어진지도 벌써 몇 달이 됐어요?\"\n음역대가 계속해서 변하는 이상한 목소리가 들려오고 있어.","choices":[{"text":"에...?","next":"1"}]},"1":{"text":"\"분명 검지가 우리를 구하러 돌아올거에요? 그 동안 더 많은 원단들을 만들며 기다려야 해요.\"\n소리가 들려오는 쪽을 보니,\n도저히 사람처럼은 안보이는 장신의 무언가가 3개나 서있어!","choices":[{"text":"검지...방금 검지라고 말한거지?","requirements":{"name":"카멜리아"},"show":false,"next":"camelia_1"},{"text":"으악!","requirements":{"not_name":"카멜리아"},"show":false,"next":"2"}]},"2":{"text":"\"이상한 사람이에요. 어떤 맛이 날까요?\"\n커다란 사람들은 벌써 너의 코앞까지 다가왔네.","choices":[{"text":"무기를 든다.","effects":{"battle":["carnival_alpha","carnival_beta","carnival_gamma"]},"next":"end_of_carnival"},{"text":"도망친다.","end":true}]},"camelia_1":{"text":"\"엄지 제식 코트를 입었으면서 검지의 천을 사용했어요?\"\n\"이상한 사람이에요. 어떤 맛이 날까요?\"\n커다란 사람들은 벌써 너의 코앞까지 다가왔네.","choices":[{"text":"아... 사실 이전에 엄지에 소속되어 있다가 검지로 전향했어요.","requirements":{"items":{"eloquence_invidia":1}},"next":"camelia_2"},{"text":"무기를 든다.","effects":{"battle":["carnival_alpha","carnival_beta","carnival_gamma"]},"next":"end_of_carnival"},{"text":"도망친다.","end":true}]},"camelia_2":{"text":"\"검지로 갔어요? 그럼 맛이 없을지도 몰라요?\"\n\"그래도 검지 사람이면 먹을 수는 없어요.\"\n커다란 사람들은 흥미를 잃은 듯 천천히 뒤로 물러났어.","choices":[{"text":"...(조용히 자리를 뜬다.)","end":true}]},"end_of_carnival":{"text":"기괴한 삼총사는 바닥으로 널부러져 더이상 움직이지 않게 되었어. 너가 그들의 시체 사이에서 발견한 건...","choices":[{"text":"값 비싸 보이는 여러 천들 (50000 안을 얻음)","effects":{"give_items":{"ahn":50000}},"end":true},{"text":"커다랗고 끔찍한 이빨 ('재단' 카드를 덱에 추가)","effects":{"give_card":"tailoring"},"end":true}]}}},{"id":"charlottes_web","start":"begin","nodes":{"begin":{"text":"더미 템플릿 인카운터에요!!!!","choices":[{"text":"발표날짜까지 기다렸는데 겨우 이정도 분량이 맞다고 생각하는거니","end":true}]}}},{"id":"health_center","start":"begin","nodes":{"begin":{"text":"한적한 골목을 걷다가 버려진 헬스장을 발견했어.\n들어가볼까?","choices":[{"text":"가보지, 뭐.","next":"1"},{"text":"바빠.","end":true}]},"1":{"text":"오랫동안 쓰이지 않아서 그런지, 퀴퀴한 냄새가 풍겨오고 있어.\n시설들이 많이 망가지긴 했지만, 그래도 벤치 프레스는 할 수 있을 것 같아.","choices":[{"text":"해본다.","next":"bench_press"},{"text":"저 기계는 뭐지...?","chance":40,"success":"good_machine","fail":"bad_machine"}]},"good_machine":{"text":"멀끔한 러닝 머신이네! 한번 달려볼까?","choices":[{"text":"해본다.","effects":{"give_item":"agility_pride"},"next":"health_end"},{"text":"아니, 벤치 프레스나 하자.","next":"bench_press"}]},"bad_machine":{"text":"기계를 살펴보니, 일종의 러닝머신 같다는게 느껴져.\n하지만 고장났는걸.\n어떡할 거야?","choices":[{"text":"쯧. 벤치 프레스나 하자.","next":"bench_press"},{"text":"고쳐본다. (성공 확률 기본 20%, 지식 [나태]당 +30%)","chance":20,"bonus_item":"intelligence_sloth","bonus_per_item":30,"success_effects":{"give_item":"intelligence_sloth"},"success":"good_machine","fail":"machine_fail"}]},"machine_fail":{"text":"엄청나게 노력을 들였지만, 결국 실패하고 말았어.\n몸이 땀으로 흠뻑 젖은건 덤이네.\n이것도 운동이라 치지 뭐.\n시간도 많이 지났으니 슬슬 나가자.","choices":[{"text":"쳇.","effects":{"sanity":-10},"end":true}]},"bench_press":{"text":"조금 무거워 보이는데, 그래도 할 만 해보이는 정도네.\n해볼까?","choices":[{"text":"힘 자랑 좀 해보실까!","effects":{"give_item":"strength_wrath"},"next":"health_end"}]},"health_end":{"text":"개운하네!\n다시 여정을 떠나볼까?","choices":[{"text":"떠난다.","end":true}]}}},{"id":"truck","start":"begin","nodes":{"begin":{"text":"대략 200km/h의 8t트럭이 달려오고 있어!","choices":[{"text":"뭐...?","effects":{"hp":-30},"next":"dmg"},{"text":"!!!!!(민첩 [오만] 1 이상 필요)","requirements":{"items":{"agility_pride":1}},"next":"phew"},{"text":"이 쯤이야. (힘 [분노] 2 이상)","requirements":{"items":{"strength_wrath":2}},"next":"phew"}]},"dmg":{"text":"쾅! 너는 트럭에 치여버렸어!","choices":[{"text":"흐에...","end":true}]},"phew":{"text":"휴... 무사히 위기를 넘긴 것 같아.","choices":[{"text":"뭐 저런 트럭이 다있어....","end":true}]}}}],"special":{"injured":[{"id":"hospital","start":"begin","nodes":{"begin":{"text":"작은 진료소를 발견했다.","choices":[{"text":"치료받는다","effects":{"remove_item":"injured"},"end":true},{"text":"떠난다","end":true}]}}}],"vending_machine":[{"id":"vending_machine1","start":"main","nodes":{"main":{"text":"길모퉁이에서 낡았지만 여전히 빛을 내뿜고 있는 자판기가 있어. 패널에는 세 가지 버튼이 활성화되어 있고. 너는 무엇을 뽑아 마셨을까?","choices":[{"text":"생수를 하나 뽑아 마신다. (HP 10 회복)","effects":{"hp":10},"end":true},{"text":"캔 커피를 하나 뽑아 마신다. (정신력 10 회복)","effects":{"sanity":10},"end":true},{"text":"무기 연마 세트를 구매한다 (카드 1장 선택 강화)","effects":{"choice_upgrade_card":true},"end":true},{"text":"자리를 떠난다","end":true}]}}},{"id":"vending_machine2","start":"main","nodes":{"main":{"text":"휘황찬란한 빛을 내뿜는 자판기가 있어. 패널에는 세 가지 버튼이 활성화되어 있고. 너는 무엇을 선택했을까?","choices":[{"text":"시원한 에너지 드링크를 뽑아 마신다 (HP 모두 회복)","effects":{"hp":999},"end":true},{"text":"따뜻한 아로마차를 뽑아 마신다 (정신력 모두 회복)","effects":{"sanity":999},"end":true},{"text":"무기 연마 세트를 구매한다 (카드 1장 선택 강화)","effects":{"choice_upgrade_card":true},"end":true},{"text":"자리를 떠난다","end":true}]}}}]},"schedule":{},"profile_default":{"death_count":0,"achievements":[],"unlocked_gadgets":["intelligence_sloth","aesthetic_gloom","strength_wrath"],"flags":{"levelup_hp":5,"levelup_sanity":5,"vending_unlocked":1,"camelia_prologue":1},"unlocked_cards":[],"enemy_kills":{},"unlocked_enemies":[]},"credits":{"bgm":[{"file":"title_theme.mp3","role":"타이틀","title":"Kokoro - Rin Kagamine (Piano Version)","artist":"WolvesOfDread","url":"https://www.youtube.com/watch?v=QkoCRvZ79EM"},{"file":"field_camelia1.mp3","role":"필드","title":"Field of Hopes and Dreams (Arrangement)","artist":"foogle","original":"DELTARUNE (Toby Fox)","url":"https://www.youtube.com/watch?v=53Ma5XodzL8"},{"file":"rude_buster.mp3","role":"전투","title":"Rude Buster - Remix Cover (DELTARUNE)","artist":"Vetrom","original":"DELTARUNE (Toby Fox)","url":"https://www.youtube.com/watch?